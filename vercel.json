{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/admin.html"
    },
    {
      "source": "/((?!assets/|favicon|logo|icons).*)",
      "destination": "/index.html"
    }
  ]
}
