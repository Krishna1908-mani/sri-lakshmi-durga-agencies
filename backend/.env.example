# Server Configuration
PORT=5000
NODE_ENV=production

# Database: Supabase PostgreSQL is the PRIMARY runtime database.
# MongoDB connection is OPTIONAL and only used by historical migration scripts (npm run migrate:*).
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ladies_store?retryWrites=true&w=majority

# Subdomain & CORS Portal URLs
FRONTEND_URL=https://app.srilakshmidurgaagencies.com
CUSTOMER_PORTAL_URL=https://app.srilakshmidurgaagencies.com
ADMIN_PORTAL_URL=https://admin.srilakshmidurgaagencies.com

# Isolated Portal JWT Authentication (Cryptographically Distinct Keys)
JWT_SECRET=your_base_jwt_secret_key_here
JWT_CUSTOMER_SECRET=your_random_64_char_customer_secret_here
JWT_ADMIN_SECRET=your_random_64_char_admin_secret_here

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / Notification Configuration
# Option 1: Resend
RESEND_API_KEY=your_resend_api_key_here
# Option 2: SMTP / Custom Email Provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Option 3: Gmail App Password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
# Sender & Admin Notifications
EMAIL_FROM="Sri Lakshmi Durga Agencies" <no-reply@srilakshmidurgaagencies.com>
ADMIN_EMAIL=your_email@gmail.com

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key
