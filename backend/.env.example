# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ladies_store?retryWrites=true&w=majority

# Frontend URL (For CORS - e.g., your Render Static Site URL)
FRONTEND_URL=https://sri-lakshmi-durga-agencies.onrender.com

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / Nodemailer Configuration (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=your_email@gmail.com
