{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:customer && npm run build:admin && node -e \"const fs=require('fs'); fs.mkdirSync('dist/customer',{recursive:true}); fs.copyFileSync('dist/index.html','dist/customer/index.html'); if(fs.existsSync('dist/assets')){fs.cpSync('dist/assets','dist/customer/assets',{recursive:true});}\"",
    "build:customer": "vite build --config vite.config.customer.js",
    "build:admin": "vite build --config vite.config.admin.js",
    "build:all": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "axios": "^1.17.0",
    "expo": "^57.0.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
