# Backend API URL (Your deployed Render Web Service URL in production, or http://localhost:5000/api in development)
VITE_API_URL=http://localhost:5000/api

# Supabase Public Configuration (Safe for browser - ONLY Publishable Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Razorpay Key ID (Public key for payment modal checkout)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
